# Copy to .env.local for local development. NEVER commit real values.

# --- Demo mode (no sign-in) ---
# Only used when the Clerk keys below are NOT set. Everyone who opens the site
# shares one demo account (data is public to anyone with the link). Requires
# SUPABASE_SECRET_KEY. Leave unset in production; Clerk keys always override it.
DEMO_MODE=

# --- Clerk (https://dashboard.clerk.com → API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Webhooks → endpoint https://<your-domain>/api/webhooks/clerk (event: user.deleted)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- Supabase (Project settings → API keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS — used by the Clerk webhook, demo mode and email reminders.
# (SUPABASE_SERVICE_ROLE_KEY and NEXT_PUBLIC_SUPABASE_ANON_KEY are accepted as legacy names.)
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Email reminders (https://resend.com → API keys) ---
RESEND_API_KEY=
# Sender. Must be on a domain you verified in Resend. Without it, Resend's test
# sender "onboarding@resend.dev" is used, which only delivers to your own Resend account email.
EMAIL_FROM="FixLog <reminders@your-domain.com>"
# Protects /api/cron/reminders. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Base URL for links in emails. Defaults to Vercel's production URL.
APP_URL=

# --- Optional: distributed rate limiting (https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
