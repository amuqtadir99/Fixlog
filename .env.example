# Copy to .env.local for local development. NEVER commit real values.

# --- Clerk (https://dashboard.clerk.com → API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Webhooks → endpoint https://<your-domain>/api/webhooks/clerk (event: user.deleted)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- Supabase (Project settings → API keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS — used exclusively by the Clerk webhook.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Optional: distributed rate limiting (https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
